# AWS Credentials (Local Development)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Frontend Configuration
NEXT_PUBLIC_DEV_MODE=true

# Backend Resource Names (Populated after deployment)
SESSIONS_TABLE=memento-sessions-ts
CONNECTIONS_TABLE=memento-connections-ts
IMAGES_BUCKET=memento-images-raw-xxx
PDF_BUCKET=memento-pdfs-final-xxx
PROCESSING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/xxx/memento-processing-queue
WEBSOCKET_URL=wss://xxx.execute-api.us-east-1.amazonaws.com/prod
